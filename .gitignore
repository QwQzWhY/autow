.venv/
__pycache__/
*.pyc

# Generated by the crawler. data/autow.db is committed on purpose: it is the
# crawler's memory, so CI knows which notices were already handled.
data/*.db-journal
data/*.db-wal
.debug/
.probe/
.browser-profile/

# Android
android/build/
android/app/build/
android/.gradle/
android/local.properties
# 例外：通知桥的 APK 要放到看板站点上，方便手机直接下载安装。
# 带版本号的那份也必须放行，否则新版本根本发不出去。
*.apk
!docs/autow-bridge.apk
!docs/autow-bridge-*.apk
